<Window x:Class="SistemGestionareLaboratorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Gestionare Laborator"
        Height="820"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#1F4E79"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="15">

        <TabControl>

            <TabItem Header="Echipamente">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="Lista echipamente"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1F4E79"/>

                            <ListBox x:Name="lstEchipamente"
                                     Height="500"
                                     SelectionChanged="lstEchipamente_SelectionChanged"/>

                        </StackPanel>

                    </Border>

                    <Grid Grid.Column="1">

                        <Border Background="White"
                                CornerRadius="10"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Gestionare echipament"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#1F4E79"/>

                                <TextBlock x:Name="lblDenumire"
                                           Text="Denumire"/>
                                <TextBox x:Name="txtDenumire"/>

                                <TextBlock x:Name="lblNumarTotal"
                                           Text="Număr total"/>
                                <TextBox x:Name="txtNumarTotal"/>

                                <TextBlock Text="Tip echipament"/>

                                <ComboBox x:Name="cmbTip"
                                          Height="30">
                                    <ComboBoxItem Content="Laptop"/>
                                    <ComboBoxItem Content="Mouse"/>
                                    <ComboBoxItem Content="Tastatura"/>
                                    <ComboBoxItem Content="Monitor"/>
                                </ComboBox>

                                <TextBlock Text="Opțiuni"/>

                                <WrapPanel Margin="5">

                                    <CheckBox x:Name="cbWireless"
                                              Content="Wireless"
                                              Margin="10"/>

                                    <CheckBox x:Name="cbUSB"
                                              Content="USB"
                                              Margin="10"/>

                                    <CheckBox x:Name="cbBluetooth"
                                              Content="Bluetooth"
                                              Margin="10"/>

                                    <CheckBox x:Name="cbHDMI"
                                              Content="HDMI"
                                              Margin="10"/>

                                </WrapPanel>



                                <StackPanel Orientation="Horizontal"
                                            Margin="0,20,0,0">

                                    <Button Content="Adaugă"
                                            Width="120"
                                            Click="BtnAdauga_Click"/>

                                    <Button Content="Actualizează"
                                            Width="120"
                                            Click="BtnActualizeaza_Click"/>

                                </StackPanel>

                                <TextBlock Text="Căutare după denumire"
                                           Margin="5,20,5,5"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBox x:Name="txtCautare"
                                             Width="250"/>

                                    <Button Content="Caută"
                                            Width="120"
                                            Click="BtnCauta_Click"/>

                                </StackPanel>

                                <Border Background="#F8F9FA"
                                        BorderBrush="#D0D7DE"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,20,0,0">

                                    <TextBlock x:Name="txtRezultat"
                                               TextWrapping="Wrap"
                                               FontSize="15"
                                               Text="Rezultatul va apărea aici."/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </TabItem>


            <TabItem Header="Studenți">

                <Grid Margin="20">

                    <Border Background="White"
                CornerRadius="10"
                Padding="20">

                        <StackPanel>

                            <TextBlock Text="Căutare student"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F4E79"/>

                            <TextBlock Text="Nume student"/>

                            <TextBox x:Name="txtCautareStudent"
                         Width="300"
                         HorizontalAlignment="Left"/>

                            <Button Content="Caută student"
                        Width="150"
                        Click="BtnCautaStudent_Click"/>

                            <Border Background="#F8F9FA"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0">

                                <TextBlock x:Name="txtRezultatStudent"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Text="Aici vor apărea împrumuturile studentului."/>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>


            <TabItem Header="Împrumuturi">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>



                    <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="Lista împrumuturi"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F4E79"/>

                            <ListBox x:Name="lstImprumuturi"
                         Height="500"/>

                        </StackPanel>

                    </Border>



                    <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="20">

                        <StackPanel>

                            <TextBlock Text="Adăugare împrumut"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F4E79"/>

                            <TextBlock x:Name="lblNumeImprumut"
                           Text="Nume student"/>

                            <TextBox x:Name="txtNumeImprumut"/>

                            <TextBlock x:Name="lblPrenumeImprumut"
                           Text="Prenume student"/>

                            <TextBox x:Name="txtPrenumeImprumut"/>

                            <TextBlock Text="Specializare"/>

                            <ComboBox x:Name="cmbSpecializareImprumut"
                          Height="30">

                                <ComboBoxItem Content="Automatică și Informatică Aplicată"/>
                                <ComboBoxItem Content="Electronică și Telecomunicații"/>
                                <ComboBoxItem Content="Calculatoare"/>
                                <ComboBoxItem Content="Informatică"/>
                                <ComboBoxItem Content="Inginerie Electrică"/>

                            </ComboBox>

                            <TextBlock Text="Echipament"/>

                            <ComboBox x:Name="cmbEchipamentImprumut"
                          Height="30"/>

                            <TextBlock Text="Data împrumutului"/>

                            <DatePicker x:Name="dpDataStart"
                            Margin="5"
                            SelectedDate="{x:Static sys:DateTime.Now}"/>

                            <TextBlock Text="Termen returnare"/>

                            <DatePicker x:Name="dpDataReturnare"
                            Margin="5"
                            SelectedDate="{x:Static sys:DateTime.Now}"/>

                            <Button Content="Adaugă împrumut"
                        Width="180"
                        Margin="5,20,5,5"
                        HorizontalAlignment="Left"
                        Click="BtnAdaugaImprumut_Click"/>
                            <Button Content="Returnează echipament"
                        Width="190"
                        Margin="5"
                        HorizontalAlignment="Left"
                        Click="BtnReturneazaImprumut_Click"/>

                            <Border Background="#F8F9FA"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0">

                                <TextBlock x:Name="txtRezultatImprumut"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Text="Rezultatul va apărea aici."/>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>